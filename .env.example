# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_USER_ID=

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# RAG / Embeddings
EMBEDDINGS_PROVIDER=mistral.ai
MISTRAL_API_KEY=

# Vector DB
VECTOR_DB=lancedb
LANCEDB_DIR=./data/lancedb

# Metadata DB
DATABASE_URL=./data/db.sqlite

# Indexing description limits and cleanup
# Shown in /latest
LATEST_DESC_MAX_CHARS=200
# Truncation for embeddings
INDEX_DESC_MAX_TOKENS=100
INDEX_DESC_MAX_CHARS=100
# If any of these patterns appear — cut description after first match
INDEX_DESC_STRIP_AFTER_PATTERNS=ПОДДЕРЖАТЬ НАС МОЖНО|+++|По вопросам сотрудничества|донат|donate|patreon|boosty|ссылки|links
# Remove lines starting with any of these prefix characters during pre-clean
INDEX_DESC_AD_LINE_PREFIX_CHARS=•,+,*,—,–,-,►,➡,→,➜

# Logging
LOG_LEVEL=info