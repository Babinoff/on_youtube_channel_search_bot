# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_USER_ID=
# Delay between messages (ms). Helps avoid Telegram rate limits
TELEGRAM_SEND_DELAY_MS=250

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# RAG / Embeddings
EMBEDDINGS_PROVIDER=mistral.ai
MISTRAL_API_KEY=
# Embeddings robustness (batched requests and retries)
EMBEDDINGS_BATCH_SIZE=8
EMBEDDINGS_MAX_ATTEMPTS=5
EMBEDDINGS_TIMEOUT_MS=30000

# Vector DB
VECTOR_DB=lancedb
LANCEDB_DIR=./data/lancedb
# LanceDB insert robustness (chunked writes and retries)
LANCEDB_INSERT_BATCH_SIZE=50
LANCEDB_INSERT_MAX_ATTEMPTS=3

# Search defaults
# Max semantic distance threshold (lower = stricter)
SEARCH_MAX_DISTANCE=0.7
# Default topK results for /search (override via "| k=10")
SEARCH_TOP_K=5

# Metadata DB
DATABASE_URL=./data/db.sqlite

# Indexing description limits and cleanup
# Shown in /latest
LATEST_DESC_MAX_CHARS=200
# Truncation for embeddings
INDEX_DESC_MAX_TOKENS=100
INDEX_DESC_MAX_CHARS=100
# If any of these patterns appear — cut description after first match
INDEX_DESC_STRIP_AFTER_PATTERNS=ПОДДЕРЖАТЬ НАС МОЖНО|+++|По вопросам сотрудничества|донат|donate|patreon|boosty|ссылки|links
# Remove lines starting with any of these prefix characters during pre-clean
INDEX_DESC_AD_LINE_PREFIX_CHARS=•,+,*,—,–,-,►,➡,→,➜

# Batch indexing
# Stop pagination on first known videoId in DB (prod=true, dev=false)
INDEX_STOP_ON_FIRST_KNOWN=false

# Logging
LOG_LEVEL=info