# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_USER_ID=
# Delay between messages (ms). Helps avoid Telegram rate limits
TELEGRAM_SEND_DELAY_MS=250

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Список каналов, доступных пользователям в боте (CSV или |)
YOUTUBE_CHANNELS_ID=

# RAG / Embeddings
EMBEDDINGS_PROVIDER=mistral
# Optional: chain for graceful fallback (e.g., "mistral,xenova")
EMBEDDINGS_PROVIDER_CHAIN=mistral,xenova
MISTRAL_API_KEY=
GOOGLE_API_KEY=
# Embeddings robustness (batched requests and retries)
EMBEDDINGS_BATCH_SIZE=8
EMBEDDINGS_MAX_ATTEMPTS=5
EMBEDDINGS_TIMEOUT_MS=30000
# Embeddings concurrency and cache
EMBEDDINGS_MAX_CONCURRENCY=1
EMBEDDINGS_CACHE_SIZE=200

# Max cap for adjustable k via settings
SEARCH_MAX_K=20

# Vector DB
VECTOR_DB=lancedb
LANCEDB_DIR=./data/lancedb
# LanceDB insert robustness (chunked writes and retries)
LANCEDB_INSERT_BATCH_SIZE=50
LANCEDB_INSERT_MAX_ATTEMPTS=3

# Search defaults
# Max semantic distance threshold (lower = stricter)
SEARCH_MAX_DISTANCE=0.7
# Default topK results for /search (override via "| k=10")
SEARCH_TOP_K=5
# Adaptive search: increase threshold when first pass yields no results
# Number of iterations (0 disables adaptation); default 3
SEARCH_ADAPTIVE_ITERS=3
# Step to increase threshold per iteration; default 0.5
SEARCH_ADAPTIVE_STEP=0.1

# Metadata DB
DATABASE_URL=./data/db.sqlite

# Description length (applies to /latest and indexing)
DESC_MAX_CHARS=500
# If any of these patterns appear — cut description after first match (CSV)
INDEX_DESC_STRIP_AFTER_PATTERNS=ПОДДЕРЖАТЬ НАС МОЖНО,+++,По вопросам сотрудничества,донат,donate,patreon,boosty,ссылки,links
# Remove lines starting with any of these prefix characters during pre-clean (CSV)
INDEX_DESC_AD_LINE_PREFIX_CHARS=•,+,*,—,–,-,►,➡,→,➜

# Batch indexing
# Stop pagination on first known videoId in DB (prod=true, dev=false)
INDEX_STOP_ON_FIRST_KNOWN=false

# Logging
LOG_LEVEL=info